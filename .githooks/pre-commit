#!/usr/bin/env bash
# Git pre-commit hook — quick syntax check before commit
# Skip with: git commit --no-verify

set -e

cd "$(dirname "$0")/../.."

# Check globe.html for basic integrity
if [ -f globe.html ]; then
  # Check for unbalanced braces
  OPEN=$(grep -o '{' globe.html | wc -l)
  CLOSE=$(grep -o '}' globe.html | wc -l)
  DIFF=$((OPEN - CLOSE))
  if [ ${DIFF#-} -gt 5 ]; then
    echo "❌ Unbalanced braces in globe.html: $OPEN open, $CLOSE close"
    exit 1
  fi
  echo "✓ globe.html brace balance OK"
fi

# Check Python files for syntax errors
for f in $(git diff --name-only --cached 2>/dev/null | grep '\.py$' || true); do
  if [ -f "$f" ]; then
    python3 -c "compile(open('$f').read(), '$f', 'exec')" 2>/dev/null || {
      echo "❌ Syntax error in $f"
      exit 1
    }
  fi
done
echo "✓ Python syntax OK"